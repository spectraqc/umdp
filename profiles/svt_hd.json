{
  "delivery_paradigm": "file",
  "content_type": "program",
  "inputs": {
    "constraints": {
      "native_frame_rate_only": true,
      "no_upconversion": true,
      "no_upscaling": true
    }
  },
  "assets": {
    "video": {
      "representation": "file",
      "codec": {
        "allowed": [
          "avc_intra_100",
          "prores_422_hq",
          "prores_422"
        ]
      },
      "container": {
        "allowed": [
          "mxf"
        ]
      },
      "bitrate": {
        "mode": "unconstrained",
        "notes": "SVT permits both AVC-Intra 100 (~113 Mbps CBR) and ProRes 422/422 HQ (VBR); no single delivery bitrate applies across the allowed codecs."
      },
      "resolution": {
        "allowed": [
          "1920x1080",
          "1280x720"
        ],
        "notes": "SVT delivers in native format: 720p/50, 1080i/25 and 1080p/25 (or 1080PsF/25). 720p/50 is SVT's transmission format (spec §1.2)."
      },
      "aspect_ratio": {
        "allowed": [
          "16:9"
        ]
      },
      "frame_rate": {
        "mode": "allowed_list",
        "allowed": [
          "25",
          "50"
        ],
        "tolerance": 0.01,
        "notes": "50 fps for 720p/50; 25 fps for 1080i/25 and 1080p/25 (or 1080PsF/25)."
      },
      "scan_type": [
        "interlaced",
        "progressive",
        "psf"
      ],
      "color": {
        "primaries": [
          "bt709"
        ],
        "transfer": [
          "bt709"
        ],
        "matrix": [
          "bt709"
        ],
        "range": [
          "limited"
        ]
      },
      "bit_depth": {
        "allowed": [
          10
        ],
        "min": 10
      },
      "chroma_subsampling": [
        "4:2:2"
      ],
      "signal": {
        "interlace_mode": [
          "psf",
          "true_interlace"
        ],
        "mains_frequency_hz": 50
      },
      "gop": {
        "closed_required": true,
        "max_length": 1
      }
    },
    "audio": {
      "codec": {
        "allowed": [
          "pcm_s24le"
        ],
        "disallowed": [
          "aac",
          "mp3",
          "ac3"
        ]
      },
      "sample_rate": [
        48000
      ],
      "bit_depth": {
        "allowed": [
          24
        ],
        "uniform_required": true
      },
      "track_count": {
        "min": 4,
        "max": 16
      },
      "language": {
        "mode": "single"
      },
      "layout": {
        "channel_map_required": true,
        "allowed_layouts": [
          "L-R",
          "L-R-C-LFE-Ls-Rs"
        ]
      },
      "loudness": {
        "standards": [
          {
            "name": "EBU R128",
            "target": -23.0,
            "tolerance": 1.0,
            "jurisdiction": "SE"
          }
        ],
        "true_peak_max": -1.0,
        "notes": "EBU R128. Programme Loudness -23.0 LUFS ±1.0 LU (SVT spec §2.2.1); content fails above -1 dBTP true peak; LRA guidance ≤18 LU."
      },
      "sync": {
        "must_match_video_duration": true
      }
    },
    "metadata": {
      "required": true,
      "schemas": [
        "EBU"
      ]
    }
  },
  "structure": {
    "type": "timeline",
    "timeline": {
      "timecode_start": "10:00:00:00"
    }
  },
  "packaging": {
    "type": "MXF_bundle"
  },
  "constraints": {
    "video": {
      "signal_limits": {
        "luminance": {
          "min": 64,
          "max": 940,
          "tolerance_percent": 1
        },
        "rgb": {
          "min": 64,
          "max": 940,
          "tolerance_percent": 1
        }
      }
    },
    "timing": {
      "duration": {
        "must_match": [
          "video",
          "audio"
        ],
        "tolerance_ms": 40
      }
    }
  },
  "id": "svt_hd",
  "name": "SVT (Sweden) — Programme Delivery",
  "governance": {
    "spec_version": "5.1",
    "effective_date": "2022-01-01",
    "supersedes": null,
    "source": "Technical_Specification_for_the_Delivery_of_Television_Programmes_as_FILES_to_SVT_v5.1.pdf",
    "jurisdiction": [
      "SE"
    ],
    "notes": "Swedish public broadcaster SVT. EBU R128 loudness, MXF AS-11-style file delivery with ProRes also accepted.",
    "verification": {
      "status": "unverified",
      "assertions": 56,
      "verified_fields": 0,
      "unsourced_fields": 0
    }
  }
}
